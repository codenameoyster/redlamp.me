{
	"name": "redlamp-me",
	"version": "1.6.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun scripts/build.ts",
		"credentials": "bun scripts/credentials.ts",
		"test": "vitest run",
		"test:browser": "bun run build && playwright test",
		"typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p web/tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p test/tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p scripts/tsconfig.json",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"lint": "eslint src web shared scripts test e2e --no-error-on-unmatched-pattern",
		"lint:fix": "bun run lint --fix"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.3.7",
		"@cloudflare/workers-types": "^5.20261006.1",
		"@playwright/test": "^1.63.0",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.12.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.148.0"
	},
	"dependencies": {
		"@astral-sh/ruff-wasm-web": "^0.17.0",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"highlight.js": "^11.12.0",
		"lucide-react": "^1.52.0",
		"pyodide": "^314.0.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
